# The root .gitignore drops every build/ folder; the Wails build assets here are source.
!/app/build/

# Build output and dependencies
node_modules/
/app/bin/
/app/.task/
/app/.wails/
/app/frontend/dist/
*.syso

# Audio fixtures: regenerated by fixtures/gen.sh (run automatically by the upload tests)
/fixtures/*.mp3
/fixtures/*.m4a
/fixtures/*.flac
/fixtures/*.ogg
/fixtures/cover.jpg

# Written by ranking/rank-ts.ts on every rank_test.go run
/ranking/all-pages.json
/ranking/ts-out.json
/ranking/searchRanking.scored.ts
